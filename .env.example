# Copy this file to .env and fill in both values from your Supabase project:
# Dashboard → Project Settings → API Keys (or the "Connect" button).
#
# .env is gitignored. Never commit real values.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key (sb_publishable_...) or, on older projects, the legacy
# "anon" key (eyJ...). Both are safe to ship to the browser: RLS is what
# protects the data, not this key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# NEVER put the secret key (sb_secret_...) or the service_role key here.
# Vite inlines every VITE_ variable into the public bundle, and those keys
# bypass RLS entirely.
